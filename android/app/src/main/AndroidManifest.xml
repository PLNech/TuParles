<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy invariant (the real moat is our outlook, not our permission set): voice,
     recordings, and any user data NEVER leave this device. The one thing that crosses
     the network is INBOUND ONLY — downloading a speech model from huggingface.co so the
     lean APK need not bundle hundreds of MB (#13). Nothing about the user is ever
     uploaded: mic audio, transcripts, and notes stay on-device; sharing a note is still
     the user's own explicit share-sheet action to an app they choose. RECORD_AUDIO
     remains the only sensitive permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Hold the mic correctly while recording: a foreground service of type
         microphone (Android 14+ requirement) + its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Inbound only: fetch a whisper model from huggingface.co via the system
         DownloadManager. No user data is ever sent out — see the invariant above. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read-only network state: check whether the active network is metered before
         the direct-HTTP download fallback runs, so allowMetered=false is honoured even
         when the system DownloadManager stalls (Android 15 scheduler deferral, #13). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- largeHeap: a take is held as PCM in RAM until stop, when its WAV is written once.
         The 2 h safety cap is 115.2 M samples = 230 MB, peaking ~460 MB while stop() hands
         over its contiguous copy — over the default heapgrowthlimit (~192-256 MB) that
         capped useful takes at ~10 min. Not a leak allowance: the audio is genuinely that
         big, and it is freed the moment the WAV lands. -->
    <application
        android:name=".TuParlesApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TuParles">

        <!-- SwiftKey's mic starts this. HeliBoard prefers the voice IME subtype. -->
        <activity
            android:name=".input.RecognizeSpeechActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.TuParles">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TuParles">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Compute backbone: owns recording off the UI lifecycle (a take survives
             screen-off / app-switch), foreground type=microphone while active. -->
        <service
            android:name=".record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- System voice input. Settings → Saisie vocale lists this. SwiftKey's
             own mic does not bind it; the TuParles keyboard is the path that does. -->
        <service
            android:name=".input.TuParlesRecognizer"
            android:exported="true"
            android:foregroundServiceType="microphone"
            android:label="@string/voice_input_name">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- Dictation strip. Enable it in Settings → Claviers, then globe to it. -->
        <service
            android:name=".input.TuParlesKeyboard"
            android:exported="true"
            android:label="@string/keyboard_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Shares a note's WAV to another app via a content:// URI. We never send it
             ourselves — the receiving app does any sending, the user drives it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
