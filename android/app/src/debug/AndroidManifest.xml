<?xml version="1.0" encoding="utf-8"?>
<!-- Debug install only. The Play copy stays pl.nech.tuparles and is not exported.
     DUMP is a development permission the shell uid holds; a normal app cannot. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service
            android:name=".record.RecordingService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:replace="android:exported" />
        <receiver
            android:name=".debug.DebugStatusReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="pl.nech.tuparles.debug.STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
